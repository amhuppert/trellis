    "@testing-library/user-event": "^14.6.1",
    "@types/d3-force": "^3.0.10",
    "@types/dagre": "^0.7.54",
    "@types/node": "^25.0.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.21.0",
