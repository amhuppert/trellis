      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./design-tokens": {
      "types": "./src/design-tokens/index.ts",
      "default": "./src/design-tokens/index.ts"
    },
    "./design-tokens/tokens.css": "./src/design-tokens/tokens.css",
    "./design-tokens/tailwind.preset": {
      "types": "./src/design-tokens/tailwind.preset.ts",
      "default": "./src/design-tokens/tailwind.preset.ts"
    },
    "./kg": {
      "types": "./src/kg/index.ts",
      "default": "./src/kg/index.ts"
    },
    "./schemas": {
      "types": "./src/schemas/index.ts",
      "default": "./src/schemas/index.ts"
    },
    "./components/primitives": {
      "types": "./src/components/primitives/index.ts",
      "default": "./src/components/primitives/index.ts"
    },
    "./components/inline": {
      "types": "./src/components/inline/index.ts",
      "default": "./src/components/inline/index.ts"
    },
    "./components/blocks": {
      "types": "./src/components/blocks/index.ts",
      "default": "./src/components/blocks/index.ts"
    },
    "./components/shell": {
      "types": "./src/components/shell/index.ts",
      "default": "./src/components/shell/index.ts"
    },
    "./components/graph": {
      "types": "./src/components/graph/index.ts",
      "default": "./src/components/graph/index.ts"
    }
  },
  "bin": {
    "trellis-validate": "./src/cli/validate.ts",
    "trellis-scaffold-report": "./src/cli/scaffold.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "validate": "trellis-validate",
    "scaffold-report": "trellis-scaffold-report"
