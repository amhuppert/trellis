{
  "initScriptPath": "scripts/worktree-init.sh",
  "preMergeCommand": "scripts/pre-merge-validate.sh",
  "devServers": [
    {
      "name": "astro",
      "command": "pnpm dev postgres-mvcc -- --host 0.0.0.0 --port $CC_ASSIGNED_PORT",
      "port": { "base": 4321, "range": 100 }
    },
    {
      "name": "storybook",
      "command": "STORYBOOK_DISABLE_TELEMETRY=1 pnpm --filter @trellis/storybook exec storybook dev --host 0.0.0.0 --port $CC_ASSIGNED_PORT --no-open",
      "port": { "base": 6006, "range": 50 }
    }
  ]
}
